# ---------------------------------------------------------------------------
# Who you are. This is how the CRM tells you apart from the people you talk to.
# ---------------------------------------------------------------------------
OPERATOR_NAME=Your Name
OPERATOR_BUSINESS=Your Business Name
# What you actually sell and service, in your own words, separated by ";".
# The analyst routes calls against this list, so keep it current — a line that
# isn't here will land in "other" rather than being guessed at.
BUSINESS_LINES=Powerboat sales and service; sailboats; kayaks and paddleboards; e-bikes; a boat club; winter storage, shrink wrap and winterization; parts and accessories
OPERATOR_EMAIL=you@yourbusiness.com
# Any other addresses that are also you (aliases, info@, etc.), comma separated.
OPERATOR_ALIASES=
# Every number that belongs to you: DIDs, extensions, mobile. Comma separated.
# Without these the CRM can't tell an inbound call from an outbound one.
OPERATOR_NUMBERS=+18155550100,+18155550101
DEFAULT_REGION=US
TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# AI. Without this key you still get recordings and transcripts, but no
# summaries, no profiles, no extracted tasks. Get one at console.anthropic.com.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max - how much thinking to spend per call.
CLAUDE_EFFORT=medium

# ---------------------------------------------------------------------------
# Email over IMAP. Sent mail matters as much as received mail - without your
# replies the CRM thinks you never answered anyone.
#
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your
# account password. Requires 2-Step Verification to be on.
# ---------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=you@yourbusiness.com
IMAP_PASSWORD=
# Leave blank to auto-detect INBOX plus the server's Sent folder.
# Override only if detection picks the wrong ones, e.g.:
#   IMAP_FOLDERS=INBOX,[Gmail]/Sent Mail
IMAP_FOLDERS=
IMAP_BACKFILL_DAYS=30
IMAP_MAX_PER_SYNC=200
EMAIL_POLL_MINUTES=10

# ---------------------------------------------------------------------------
# Call recordings from the PBX. See docs/sangoma-setup.md.
# Use whichever applies - a watch folder, the webhook, or neither (manual upload).
# ---------------------------------------------------------------------------
SANGOMA_WATCH_DIR=
SANGOMA_WEBHOOK_SECRET=
PIPELINE_POLL_SECONDS=30

# ---------------------------------------------------------------------------
# Transcription. faster_whisper runs locally and sends no audio anywhere.
# Models, smallest to largest: tiny.en, base.en, small.en, medium.en, large-v3
# small.en is a good balance on a CPU; large-v3 wants a GPU.
# ---------------------------------------------------------------------------
TRANSCRIPTION_ENGINE=faster_whisper
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
SPLIT_STEREO_CHANNELS=true
# The shop already uses AssemblyAI for mechanic voice notes — reuse that key to
# keep one vendor across both apps. Note this uploads audio off the machine.
# TRANSCRIPTION_ENGINE=assemblyai
ASSEMBLYAI_API_KEY=

# Alternative cloud engine with real speaker diarisation:
# TRANSCRIPTION_ENGINE=deepgram
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Service tracker (QuestWS/servicetracker) — the shop's work-order app.
# The /exec URL is the one already in its assets/lib/config.js. The password is
# its ADMIN_PASSWORD script property. See docs/servicetracker-integration.md.
# ---------------------------------------------------------------------------
SERVICETRACKER_EXEC_URL=
SERVICETRACKER_PASSWORD=
SERVICETRACKER_SYNC_MINUTES=10
# Staged notes wait for a click by default, matching the shop's rule that
# nothing goes out on a timer. Turn on only if you want them pushed unattended.
SERVICETRACKER_AUTOPUSH=false

# ---------------------------------------------------------------------------
# Winter services (QuestWS/winter-quotes_26-27) — the seasonal quote system.
# The /exec URL is the API_URL already in its admin/index.html. WINTER_PIN is a
# staff console PIN; it needs the "keys" permission to add staff notes.
# The CRM never sends customer email from this system — that repo forbids it,
# and no send function is wrapped.
# ---------------------------------------------------------------------------
WINTER_EXEC_URL=
WINTER_PIN=

# ---------------------------------------------------------------------------
# Google Calendar. Run `python -m crm.cli google-auth` once after filling this in.
# Calendar scopes only - email comes over IMAP above.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_SECRET_FILE=.credentials/client_secret.json
GOOGLE_TOKEN_FILE=.credentials/token.json
CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Storage and server
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/crm.db
MEDIA_ROOT=./media
HOST=127.0.0.1
PORT=8000
BRIEFING_HOUR=7
